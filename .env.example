# SkyGuard Aviation Environment Configuration Template
# Copy this file to .env or set these environment variables in your system

# Database Settings (Default points to local MySQL instance)
DB_URL=jdbc:mysql://localhost:3306/aviation_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=root
DB_PASSWORD=root

# Optional: AI Copilot Cloud API Key (OpenAI / compatible)
# Leave blank to use SkyGuard's built-in Aviation Safety Reasoning Engine
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
